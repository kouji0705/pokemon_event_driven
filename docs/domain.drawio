    <diagram id="domain-model" name="ドメインモデル">
        <mxGraphModel dx="1511" dy="851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1080" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="context" value="境界づけられたコンテキスト: 通常ターン（1対1、2ターン目以降）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=16;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="40" width="1600" height="900" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="青 = 集約　　緑 = エンティティ　　黄 = 値オブジェクト　　橙 = 出来事　　紫 = ドメインサービス" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="64" y="84" width="900" height="28" as="geometry"/>
