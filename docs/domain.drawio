                <mxCell id="attack" value="&lt;b&gt;AttackAction&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;値オブジェクト&lt;/font&gt;&lt;hr&gt;kind: attack&lt;br&gt;damage: number&lt;hr&gt;&lt;b&gt;Actions&lt;/b&gt;&lt;br&gt;Pokemon.id → AttackAction&lt;br&gt;双方の攻撃が揃った入力" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="70" y="140" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="battle" value="&lt;b&gt;Battle&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;集約ルート&lt;/font&gt;&lt;hr&gt;turn: number&lt;br&gt;pokemon: [Pokemon, Pokemon]&lt;hr&gt;1ターンの状態。場にいる2体を持つ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="460" y="140" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="pokemon" value="&lt;b&gt;Pokemon&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;エンティティ&lt;/font&gt;&lt;hr&gt;id: string&lt;br&gt;name: string&lt;br&gt;hp: number&lt;br&gt;speed: number&lt;hr&gt;比較とログが使うのは id と speed。表示名では順を決めない" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="900" y="130" width="340" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="order" value="&lt;b&gt;orderBySpeed&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;ドメインサービス&lt;/font&gt;&lt;hr&gt;(a: Pokemon, b: Pokemon)&lt;br&gt;→ [先攻, 後攻]&lt;hr&gt;speed が大きい方を先攻にする&lt;br&gt;同速・優先度・トリックルームは未定義" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="360" width="330" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="run" value="&lt;b&gt;runTurn&lt;/b&gt;&lt;br&gt;&lt;font color='#666666'&gt;ドメインサービス&lt;/font&gt;&lt;hr&gt;(battle: Battle, actions: Actions) → TurnResult&lt;hr&gt;1ターンの手順を持つ&lt;br&gt;入力の Battle は変更しない&lt;br&gt;MoveUsed のあと HP を減らし、DamageApplied を積む&lt;br&gt;TurnEnded のあと turn を 1 増やす&lt;br&gt;購読やハンドラは持たない" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="460" y="400" width="520" height="210" as="geometry"/>
